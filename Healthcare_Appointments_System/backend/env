# ─────────────────────────────────────────────────────────────────────────────
# Healthcare Appointments System — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=421842004
POSTGRES_DB=healthcare_db

# Full async URL used by SQLAlchemy / Alembic
# (docker-compose sets this automatically; override for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:421842004@localhost:5433/healthcare_db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=randomthingsthatshouldberandomandsecure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow the Vite dev server origin during local development.
# In production the frontend is served from the same origin — this can be left
# as an empty list: '[]'
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
